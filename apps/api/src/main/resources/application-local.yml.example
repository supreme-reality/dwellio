# Copy to application-local.yml (gitignored — keep secrets out of git).
# Activate with: SPRING_PROFILES_ACTIVE=local
#
# Your tenant (from Auth0):
#   issuer-uri: https://dev-kr70stcvfslmubzf.us.auth0.com/

spring:
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: https://YOUR_TENANT.us.auth0.com/

dwellio:
  auth0:
    # Must match Auth0 API Identifier
    audience: https://api.dwellio.local
