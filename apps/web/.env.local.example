# Copy to .env.local and fill from Auth0 Dashboard (see docs/auth0-setup.md).

# openssl rand -hex 32
AUTH0_SECRET=

# Auth0 Next.js SDK v4
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Auth0 API Identifier (must match API resource-server audience)
AUTH0_AUDIENCE=https://api.dwellio.local

# Dwellio Spring API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Razorpay Checkout (client key only; secrets stay on API)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
