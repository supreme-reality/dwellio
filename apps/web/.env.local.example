# Copy to .env.local and fill from Auth0 Dashboard (see docs/auth0-setup.md).

# openssl rand -hex 32
AUTH0_SECRET=

# Local web origin
AUTH0_BASE_URL=http://localhost:3000

# https://YOUR_TENANT.REGION.auth0.com  (no path; trailing slash optional)
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.us.auth0.com

AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Auth0 API Identifier (must match API resource-server audience)
AUTH0_AUDIENCE=https://api.dwellio.local

# Dwellio Spring API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
