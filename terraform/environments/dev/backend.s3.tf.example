# Copy to backend.tf after creating the state bucket (see ../../README.md).
# Then: terraform init -migrate-state
terraform {
  backend "s3" {
    bucket       = "dwellio-terraform-state" # replace if needed
    key          = "dwellio/terraform/dev/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true
  }
}
